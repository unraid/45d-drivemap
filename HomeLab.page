<?php
$rgb_helper = '/usr/local/emhttp/plugins/45homelab/php/rgb_schedule.php';
if (!is_file($rgb_helper)) {
  $rgb_helper = __DIR__ . '/php/rgb_schedule.php';
}
require_once $rgb_helper;

$message = null;
$error = null;
$schedule_action = ($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST' && ($_POST['schedule_action'] ?? null) === 'save';
if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
  // Unraid validates and removes csrf_token before rendering this page.
  if (($_POST['schedule_action'] ?? null) === 'save') {
    $result = homelab_schedule_save($_POST);
    if ($result['ok']) {
      $message = 'Night schedule saved.';
    } else {
      $error = $result['error'];
    }
  } else {
    $action = $_POST['lighting_action'] ?? 'global';
    if ($action === 'separate') {
      $top = $_POST['color_primary'] ?? '';
      $bottom = $_POST['color_secondary'] ?? '';
      $result = homelab_rgb_set_separate($top, $bottom);
      $label = 'Separate fan colors';
    } elseif (is_string($action) && isset(HOMELAB_STREAM_EFFECTS[$action])) {
      $result = homelab_rgb_set_stream_effect($action, $_POST);
      $label = HOMELAB_STREAM_EFFECTS[$action];
    } elseif ($action === 'custom-leds') {
      $result = homelab_rgb_set_custom($_POST['led_colors'] ?? null, $_POST);
      $label = 'Custom LEDs';
    } elseif ($action === 'global') {
      $preset = $_POST['color'] ?? '';
      $result = homelab_rgb_set($preset);
      $label = homelab_rgb_label($preset);
    } else {
      $result = ['ok' => false, 'error' => 'Choose a listed lighting option.'];
    }
    if ($result['ok']) {
      if (!homelab_schedule_record_day($action, $_POST)) {
        $error = 'Lights changed, but the daytime mode was not saved.';
      } else {
        $schedule = homelab_schedule_load();
        if (homelab_schedule_is_night($schedule)) {
          $night = homelab_schedule_tick(true);
          if ($night['ok']) {
            $message = 'Daytime mode saved. Night mode is still on.';
          } else {
            $error = 'Daytime mode saved. Night mode failed: ' . $night['error'];
          }
        } else {
          $message = $label . ' applied.';
        }
      }
    } else {
      $error = $result['error'];
    }
  }
}
$schedule = homelab_schedule_load();
$schedule_form = $schedule;
if ($schedule_action && $error !== null) {
  $schedule_form = [
    'enabled' => ($_POST['enabled'] ?? null) === '1',
    'start' => is_string($_POST['start'] ?? null) ? $_POST['start'] : '',
    'end' => is_string($_POST['end'] ?? null) ? $_POST['end'] : '',
  ];
}
$day_selection = homelab_schedule_day_selection();
$active_streaming = homelab_stream_pid() !== null;
$streaming = $active_streaming;
$selection = homelab_rgb_stream_selection();
$stream_config = json_decode((string) @file_get_contents(homelab_stream_paths()['config']), true);
$separate_colors = [
  'top' => HOMELAB_RGB_PRESETS[$selection['top']]['color'] ?: '000000',
  'bottom' => HOMELAB_RGB_PRESETS[$selection['bottom']]['color'] ?: '000000',
];
foreach (['top', 'bottom'] as $fan) {
  if (is_array($stream_config) && is_string($stream_config[$fan] ?? null) &&
      preg_match('/^[0-9A-Fa-f]{6}$/D', $stream_config[$fan])) {
    $separate_colors[$fan] = strtoupper($stream_config[$fan]);
  }
}
if ($schedule['enabled'] && homelab_schedule_is_night($schedule) && is_array($day_selection)) {
  $streaming = ($day_selection['kind'] ?? null) === 'stream';
  if ($streaming) {
    $stream_config = $day_selection['config'];
  }
}
$preview_mode = $streaming && (isset(HOMELAB_STREAM_EFFECTS[$stream_config['effect'] ?? '']) ||
  ($stream_config['effect'] ?? null) === 'custom-leds')
  ? $stream_config['effect'] : ($streaming ? 'separate' : 'global');
$global_preset = ($day_selection['kind'] ?? null) === 'global' ? $day_selection['preset'] : 'white';
$custom_palette = homelab_rgb_custom_palette();
try {
  $tuning = homelab_stream_tuning(is_array($stream_config) ? $stream_config : []);
} catch (InvalidArgumentException $ignored) {
  $tuning = HOMELAB_STREAM_TUNING_DEFAULTS;
}
$detected = $active_streaming ? ['ok' => true, 'error' => null] : homelab_rgb_detect();
$ready = $detected['ok'];
if (!$ready && $error === null) {
  $error = $detected['error'];
}
?>
