<?php
$rgb_helper = '/usr/local/emhttp/plugins/45homelab/php/rgb_control.php';
if (!is_file($rgb_helper)) {
  $rgb_helper = __DIR__ . '/php/rgb_control.php';
}
require_once $rgb_helper;

$message = null;
$error = null;
if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
  // Unraid validates and removes csrf_token before rendering this page.
  $action = $_POST['lighting_action'] ?? 'global';
  if ($action === 'separate') {
    $top = $_POST['top_color'] ?? '';
    $bottom = $_POST['bottom_color'] ?? '';
    $result = homelab_rgb_set_separate($top, $bottom);
    $label = 'Separate fan colors';
  } elseif ($action === 'pinwheel-rainbow') {
    $result = homelab_rgb_set_pinwheel();
    $label = 'Outer Loop';
  } elseif ($action === 'synchronized-rainbow') {
    $result = homelab_rgb_set_synchronized_rainbow();
    $label = 'Synchronized Rainbow';
  } elseif ($action === 'global') {
    $preset = $_POST['color'] ?? '';
    $result = homelab_rgb_set($preset);
    $label = homelab_rgb_label($preset);
  } else {
    $result = ['ok' => false, 'error' => 'Choose a listed lighting option.'];
  }
  if ($result['ok']) {
    $message = $label . ' applied to fan lights.';
  } else {
    $error = $result['error'];
  }
}
$streaming = homelab_stream_pid() !== null;
$selection = homelab_rgb_stream_selection();
$stream_config = $streaming ? json_decode((string) @file_get_contents(homelab_stream_paths()['config']), true) : null;
$preview_mode = ($stream_config['effect'] ?? null) === 'pinwheel-rainbow' ? 'pinwheel-rainbow' : 'synchronized-rainbow';
$detected = $streaming ? ['ok' => true, 'error' => null] : homelab_rgb_detect();
$ready = $detected['ok'];
if (!$ready && $error === null) {
  $error = $detected['error'];
}
?>
<div style="max-width: 48rem;">
  <h2>Fan lighting</h2>
  <p>Set a solid color or animated effect for the X4 fans connected to the ASRock addressable header.</p>
  <p>The two daisy-chained fans each have 12 LEDs. Separate colors and streamed effects use the X4 controller.</p>
  <?php if ($message): ?>
    <p role="status"><?=htmlspecialchars($message, ENT_QUOTES, 'UTF-8')?></p>
  <?php endif; ?>
  <?php if ($error): ?>
    <p role="alert"><?=htmlspecialchars($error, ENT_QUOTES, 'UTF-8')?></p>
  <?php endif; ?>
  <form method="post">
    <input type="hidden" name="csrf_token" value="<?=htmlspecialchars((string)($var['csrf_token'] ?? ''), ENT_QUOTES, 'UTF-8')?>">
    <input type="hidden" name="lighting_action" value="global">
    <label for="homelab-fan-color">Lighting</label>
    <select id="homelab-fan-color" name="color" <?=$ready ? '' : 'disabled'?>>
      <option value="" selected disabled>Choose lighting</option>
      <optgroup label="Solid colors">
        <?php foreach (HOMELAB_RGB_PRESETS as $value => $preset): ?>
          <option value="<?=htmlspecialchars($value, ENT_QUOTES, 'UTF-8')?>"><?=htmlspecialchars($preset['label'], ENT_QUOTES, 'UTF-8')?></option>
        <?php endforeach; ?>
      </optgroup>
      <optgroup label="Animated effects">
        <?php foreach (HOMELAB_RGB_EFFECTS as $value => $effect): ?>
          <option value="<?=htmlspecialchars($value, ENT_QUOTES, 'UTF-8')?>"><?=htmlspecialchars($effect['label'], ENT_QUOTES, 'UTF-8')?></option>
        <?php endforeach; ?>
      </optgroup>
    </select>
    <input type="submit" value="Apply lighting" <?=$ready ? '' : 'disabled'?>>
  </form>
  <h3>Separate fan colors</h3>
  <form method="post">
    <input type="hidden" name="csrf_token" value="<?=htmlspecialchars((string)($var['csrf_token'] ?? ''), ENT_QUOTES, 'UTF-8')?>">
    <input type="hidden" name="lighting_action" value="separate">
    <label for="homelab-top-color">Top fan</label>
    <select id="homelab-top-color" name="top_color" <?=$ready ? '' : 'disabled'?>>
      <?php foreach (HOMELAB_RGB_PRESETS as $value => $preset): ?>
        <option value="<?=htmlspecialchars($value, ENT_QUOTES, 'UTF-8')?>" <?=$value === $selection['top'] ? 'selected' : ''?>><?=htmlspecialchars($preset['label'], ENT_QUOTES, 'UTF-8')?></option>
      <?php endforeach; ?>
    </select>
    <label for="homelab-bottom-color">Bottom fan</label>
    <select id="homelab-bottom-color" name="bottom_color" <?=$ready ? '' : 'disabled'?>>
      <?php foreach (HOMELAB_RGB_PRESETS as $value => $preset): ?>
        <option value="<?=htmlspecialchars($value, ENT_QUOTES, 'UTF-8')?>" <?=$value === $selection['bottom'] ? 'selected' : ''?>><?=htmlspecialchars($preset['label'], ENT_QUOTES, 'UTF-8')?></option>
      <?php endforeach; ?>
    </select>
    <input type="submit" value="Apply separate colors" <?=$ready ? '' : 'disabled'?>>
  </form>
  <h3>Animated preview</h3>
  <p>The preview shows the LED positions on both hubs. Its timing is independent of the fans, and fan blades may diffuse light differently.</p>
  <form method="post" id="homelab-rgb-preview">
    <input type="hidden" name="csrf_token" value="<?=htmlspecialchars((string)($var['csrf_token'] ?? ''), ENT_QUOTES, 'UTF-8')?>">
    <label for="homelab-preview-mode">Pattern</label>
    <select id="homelab-preview-mode" name="lighting_action" <?=$ready ? '' : 'disabled'?>>
      <option value="pinwheel-rainbow" <?=$preview_mode === 'pinwheel-rainbow' ? 'selected' : ''?>>Outer Loop</option>
      <option value="synchronized-rainbow" <?=$preview_mode === 'synchronized-rainbow' ? 'selected' : ''?>>Synchronized Rainbow</option>
    </select>
    <input type="submit" value="Apply previewed pattern" <?=$ready ? '' : 'disabled'?>>
    <button type="button" data-pause aria-pressed="false">Pause preview</button>
    <label><input type="checkbox" data-numbers> LED numbers</label>
    <canvas width="420" height="600" role="img" aria-label="Preview of top and bottom X4 fans with 12 hub LEDs each" style="display:block;width:min(100%,420px);height:auto;margin:1rem auto;"></canvas>
    <p data-description aria-live="polite"></p>
  </form>
</div>
<script src="/plugins/45homelab/assets/45d/rgb-preview.js?v=1"></script>
