<?php
$rgb_helper = '/usr/local/emhttp/plugins/45homelab/php/rgb_control.php';
if (!is_file($rgb_helper)) {
  $rgb_helper = __DIR__ . '/php/rgb_control.php';
}
require_once $rgb_helper;

$message = null;
$error = null;
if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
  $expected_token = (string)($var['csrf_token'] ?? '');
  $given_token = $_POST['csrf_token'] ?? '';
  $given_token = is_string($given_token) ? $given_token : '';
  if ($expected_token === '' || !hash_equals($expected_token, $given_token)) {
    $error = 'Request expired. Reload this page and try again.';
  } else {
    $preset = $_POST['color'] ?? '';
    $result = homelab_rgb_set($preset);
    if ($result['ok']) {
      $message = HOMELAB_RGB_PRESETS[$preset]['label'] . ' applied to fan lights.';
    } else {
      $error = $result['error'];
    }
  }
}
$detected = homelab_rgb_detect();
$ready = $detected['ok'];
if (!$ready && $error === null) {
  $error = $detected['error'];
}
?>
<div style="max-width: 48rem;">
  <h2>Fan lighting</h2>
  <p>Set one solid color for the X4 fans connected to the ASRock addressable header.</p>
  <?php if ($message): ?>
    <p role="status"><?=htmlspecialchars($message, ENT_QUOTES, 'UTF-8')?></p>
  <?php endif; ?>
  <?php if ($error): ?>
    <p role="alert"><?=htmlspecialchars($error, ENT_QUOTES, 'UTF-8')?></p>
  <?php endif; ?>
  <form method="post">
    <input type="hidden" name="csrf_token" value="<?=htmlspecialchars((string)($var['csrf_token'] ?? ''), ENT_QUOTES, 'UTF-8')?>">
    <label for="homelab-fan-color">Color</label>
    <select id="homelab-fan-color" name="color" <?=$ready ? '' : 'disabled'?>>
      <option value="" selected disabled>Choose a color</option>
      <?php foreach (HOMELAB_RGB_PRESETS as $value => $preset): ?>
        <option value="<?=htmlspecialchars($value, ENT_QUOTES, 'UTF-8')?>"><?=htmlspecialchars($preset['label'], ENT_QUOTES, 'UTF-8')?></option>
      <?php endforeach; ?>
    </select>
    <input type="submit" value="Apply color" <?=$ready ? '' : 'disabled'?>>
  </form>
</div>
