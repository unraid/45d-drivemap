<?php
$rgb_helper = '/usr/local/emhttp/plugins/45homelab/php/rgb_control.php';
if (!is_file($rgb_helper)) {
  $rgb_helper = __DIR__ . '/php/rgb_control.php';
}
require_once $rgb_helper;

$message = null;
$error = null;
if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
  // Unraid validates and removes csrf_token before rendering this page.
  $preset = $_POST['color'] ?? '';
  $result = homelab_rgb_set($preset);
  if ($result['ok']) {
    $message = homelab_rgb_label($preset) . ' applied to fan lights.';
  } else {
    $error = $result['error'];
  }
}
$detected = homelab_rgb_detect();
$ready = $detected['ok'];
if (!$ready && $error === null) {
  $error = $detected['error'];
}
?>
<div style="max-width: 48rem;">
  <h2>Fan lighting</h2>
  <p>Set a solid color or animated effect for the X4 fans connected to the ASRock addressable header.</p>
  <p>Built-in effects may look mirrored across the two daisy-chained fans. Separate fan settings are unavailable while per-LED updates on this controller remain unreliable.</p>
  <?php if ($message): ?>
    <p role="status"><?=htmlspecialchars($message, ENT_QUOTES, 'UTF-8')?></p>
  <?php endif; ?>
  <?php if ($error): ?>
    <p role="alert"><?=htmlspecialchars($error, ENT_QUOTES, 'UTF-8')?></p>
  <?php endif; ?>
  <form method="post">
    <input type="hidden" name="csrf_token" value="<?=htmlspecialchars((string)($var['csrf_token'] ?? ''), ENT_QUOTES, 'UTF-8')?>">
    <label for="homelab-fan-color">Lighting</label>
    <select id="homelab-fan-color" name="color" <?=$ready ? '' : 'disabled'?>>
      <option value="" selected disabled>Choose lighting</option>
      <optgroup label="Solid colors">
        <?php foreach (HOMELAB_RGB_PRESETS as $value => $preset): ?>
          <option value="<?=htmlspecialchars($value, ENT_QUOTES, 'UTF-8')?>"><?=htmlspecialchars($preset['label'], ENT_QUOTES, 'UTF-8')?></option>
        <?php endforeach; ?>
      </optgroup>
      <optgroup label="Animated effects">
        <?php foreach (HOMELAB_RGB_EFFECTS as $value => $effect): ?>
          <option value="<?=htmlspecialchars($value, ENT_QUOTES, 'UTF-8')?>"><?=htmlspecialchars($effect['label'], ENT_QUOTES, 'UTF-8')?></option>
        <?php endforeach; ?>
      </optgroup>
    </select>
    <input type="submit" value="Apply lighting" <?=$ready ? '' : 'disabled'?>>
  </form>
</div>
