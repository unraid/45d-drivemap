#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
VERSION="${1:-$(awk -F= '/^version=/{print $2}' "${ROOT_DIR}/plugin.cfg")}"
PLUGIN_NAME="45homelab"
PACKAGE_NAME="${PLUGIN_NAME}-${VERSION}.txz"
PACKAGE_DIR="${ROOT_DIR}/packages"
PACKAGE_PATH="${PACKAGE_DIR}/${PACKAGE_NAME}"

STAGE_DIR=$(mktemp -d)
FILE_LIST=""
cleanup() {
  rm -rf "${STAGE_DIR}"
  if [[ -n "${FILE_LIST}" ]]; then
    rm -f "${FILE_LIST}"
  fi
}
trap cleanup EXIT

TARGET_DIR="${STAGE_DIR}/usr/local/emhttp/plugins/${PLUGIN_NAME}"
mkdir -p "${TARGET_DIR}"

cp -a \
  "${ROOT_DIR}/DriveMap.page" \
  "${ROOT_DIR}/HomeLab.page" \
  "${ROOT_DIR}/plugin.cfg" \
  "${ROOT_DIR}/assets" \
  "${ROOT_DIR}/php" \
  "${ROOT_DIR}/include" \
  "${ROOT_DIR}/scripts" \
  "${TARGET_DIR}/"

# Dev helpers/pages are excluded from stable packaging by default.
if [[ "${INCLUDE_DEV_TOOLS_PAGE:-0}" == "1" ]] && [[ -f "${ROOT_DIR}/DriveMapDevTools.page" ]]; then
  cp -a "${ROOT_DIR}/DriveMapDevTools.page" "${TARGET_DIR}/"
  if [[ -f "${ROOT_DIR}/DriveMapDevToolsSimulator.page" ]]; then
    cp -a "${ROOT_DIR}/DriveMapDevToolsSimulator.page" "${TARGET_DIR}/"
  fi
fi

# Build and release helpers are not needed on the Unraid runtime.
rm -f \
  "${TARGET_DIR}/scripts/build-assets-txz" \
  "${TARGET_DIR}/scripts/build-plugin-txz" \
  "${TARGET_DIR}/scripts/render-plg"

mkdir -p "${PACKAGE_DIR}"
rm -f "${PACKAGE_PATH}"

# Keep package metadata Linux-friendly when building on macOS.
export COPYFILE_DISABLE=1

# Normalize mtimes so the same inputs yield the same package hash.
find "${STAGE_DIR}/usr" -exec touch -t 200001010000 {} +

if ! command -v xz >/dev/null 2>&1; then
  echo "xz is required to build ${PACKAGE_NAME}" >&2
  exit 1
fi

TAR_ARGS=()
if tar --version 2>/dev/null | head -n 1 | grep -qi "gnu tar"; then
  TAR_BIN="tar"
  TAR_ARGS+=(--owner=0 --group=0 --numeric-owner --no-acls --no-xattrs --sort=name --mtime=@946684800 --no-recursion)
else
  TAR_BIN="bsdtar"
  TAR_ARGS+=(--uid 0 --gid 0 --uname root --gname root --no-acls --no-fflags --no-mac-metadata --no-xattrs -n)
fi

FILE_LIST=$(mktemp)
(cd "${STAGE_DIR}" && find ./usr -print | LC_ALL=C sort > "${FILE_LIST}")

"${TAR_BIN}" -C "${STAGE_DIR}" "${TAR_ARGS[@]}" -cf - -T "${FILE_LIST}" \
  | xz --threads=0 -c > "${PACKAGE_PATH}"

# Guard against archiving the staging root itself (./), which can clobber /
# permissions when extracting with -C /.
if tar -tf "${PACKAGE_PATH}" | grep -Eq '^\.?/?$|^\./$'; then
  echo "Refusing to publish package containing top-level ./ entry" >&2
  exit 1
fi

SHA256=$(shasum -a 256 "${PACKAGE_PATH}" | awk '{print $1}')
printf '%s\n' "${PACKAGE_PATH}"
printf '%s\n' "${SHA256}"
